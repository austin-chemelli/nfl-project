[Unit]
Description=NFL narrative passes: Wednesday 18:00 and Saturday 07:00 Eastern (PASSES in src/nfl/llm/narrative.py)

[Timer]
OnCalendar=Wed *-*-* 18:00:00 America/New_York
OnCalendar=Sat *-*-* 07:00:00 America/New_York
# A pass missed while the PC was off or WSL wasn't running runs at the next start; games already
# kicked off are skipped, and games stored earlier in the pass window are not redone.
Persistent=true
RandomizedDelaySec=1min

[Install]
WantedBy=timers.target
