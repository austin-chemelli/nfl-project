NFL_DATA_ROOT=./data
# The Odds API (free tier, 500 credits/month): https://the-odds-api.com
ODDS_API_KEY=

# Local LLM server on the desktop (ADR 0014, docs/desktop-llm-setup.md). Host = the desktop's
# Tailscale IP (`tailscale status` on the desktop); from the desktop's own WSL, SEARX_URL can be
# http://localhost:8080.
LLM_BASE_URL=http://<desktop-tailscale-ip>:11434/v1
LLM_MODEL=qwen3.5:9b
SEARX_URL=http://<desktop-tailscale-ip>:8080
# LLM client (src/nfl/llm/client.py): desktop only, no paid fallback (ADR 0014).
# LLM_TIMEOUT_S=300
# LLM_LOCAL_WATTS=225   # desktop draw while generating; energy estimate in the call log
